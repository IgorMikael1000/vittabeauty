# Runtime connection (Neon pooled connection string recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Prisma CLI connection (Neon direct, non-pooled connection string)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional public origin for generating the absolute booking link
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Authentication Web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-with-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"

# Firebase Admin SDK credentials (server-only account with Firebase Auth Admin role)
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-admin-service-account@example.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="replace-with-service-account-private-key"

# Cloudinary server-side profile image storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

# Mercado Pago one-time Checkout Pro payments
MERCADOPAGO_ACCESS_TOKEN="replace-with-mercadopago-access-token"
MERCADOPAGO_WEBHOOK_SECRET="replace-with-mercadopago-webhook-secret"

# Distributed rate limiting for public server actions (Upstash Redis REST)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-redis-rest-token"

# Server-only signing secret for the application session cookie (minimum 32 bytes)
AUTH_SESSION_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Vercel Cron authorization secret for account deletion retries
CRON_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"
