# Runtime connection (Neon pooled connection string recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Prisma CLI connection (Neon direct, non-pooled connection string)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Optional public origin for generating the absolute booking link
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Authentication Web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-with-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"
