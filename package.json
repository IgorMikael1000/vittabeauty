    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.9",
    "firebase": "^13.1.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "mercadopago": "^3.6.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
